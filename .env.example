# ============================================================
# Anthropic API 配置示例文件
# ------------------------------------------------------------
# 用法：复制本文件为 .env 并填入真实密钥
#   cp .env.example .env   (Linux/Mac/Git Bash)
#   copy .env.example .env (Windows CMD)
# ============================================================

# --- API 密钥（必填）---
# DeepSeek 平台申请：https://platform.deepseek.com/
ANTHROPIC_API_KEY=sk-你的DeepSeek密钥

# --- 接口地址（DeepSeek 的 Anthropic 兼容端点）---
# DeepSeek 提供 Anthropic 协议兼容接口，ChatAnthropic 客户端可直接调用
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# --- 模型配置（DeepSeek 统一使用 deepseek-v4-flash）---
# 系统三层调用（Haiku/Sonnet/Opus）在 DeepSeek 下均映射到同一模型
MODEL_HAIKU=deepseek-v4-flash
MODEL_SONNET=deepseek-v4-flash
MODEL_OPUS=deepseek-v4-flash

# --- 可选：Embedding 提供方（留空则使用占位 stub，正式环境建议配置）---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
